# ============================================
# TradeDiary - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

# Database Configuration
# Choose ONE of the following options:

# Option 1: Local MongoDB (Development)
# DATABASE_URL="mongodb://localhost:27017/tradediary"

# Option 2: MongoDB Atlas (Production/Cloud)
# Uncomment and update with your MongoDB Atlas connection string:
DATABASE_URL="mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/tradediary?retryWrites=true&w=majority"
#
# Important:
# - Replace 'username' and 'password' with your MongoDB Atlas credentials
# - Replace 'cluster0.xxxxx' with your actual cluster name
# - URL encode special characters in password (@ = %40, # = %23, etc.)
# - See docs/MONGODB_ATLAS_SETUP.md for detailed instructions

# ============================================
# NextAuth Configuration (REQUIRED)
# ============================================

# Secret key for JWT encryption (DO NOT SHARE THIS)
# Generate one with: npm run generate-secret
NEXTAUTH_SECRET=""

# Application URL
# For local development:
NEXTAUTH_URL="http://localhost:3000"

# For production, update to your domain:
# NEXTAUTH_URL="https://yourdomain.com"

# ============================================
# Google OAuth (for "Continue with Google" sign-in)
# ============================================

# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# e.g. for local dev: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================
# Encryption (for storing broker API keys at rest)
# ============================================

# Used to encrypt/decrypt exchange API credentials before storing them.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret, and back it up: if it's lost or changed, previously-stored encrypted
# credentials become unrecoverable and users will need to reconnect their exchange.
ENCRYPTION_KEY=""

# ============================================
# Stripe (for the subscription-gated learning platform)
# ============================================

# From https://dashboard.stripe.com/apikeys (use a test-mode key while developing)
STRIPE_SECRET_KEY=""
# From https://dashboard.stripe.com/products — create one recurring Price for the single
# "Pro" tier and paste its price_... id here
STRIPE_PRICE_ID=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (local dev) or the
# webhook endpoint's signing secret in the Stripe dashboard (production)
STRIPE_WEBHOOK_SECRET=""

# ============================================
# Node Environment
# ============================================

NODE_ENV="development"

# ============================================
# Optional: Email Configuration (for password reset)
# ============================================

# Uncomment and configure when ready to send emails:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-email-password"
# SMTP_FROM="noreply@tradediary.com"
